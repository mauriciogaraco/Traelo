# Backend de Tráelo (el mismo que usa la app móvil). Sin /api/v1: lo agrega src/config/env.ts.
# Por defecto (sin esta variable) se usa producción: https://api.traelo-market.com
# Para desarrollar contra el de pruebas: https://backend-fi7x.onrender.com
# VITE_API_URL=https://backend-fi7x.onrender.com

# X-Api-Key del backend (MOBILE_APP_API_KEY en el servidor). Opcional: sin ella se usa la de la app.
VITE_API_KEY=

# Solo en Vercel (funciones /api, nunca en el navegador): aviso de pedidos al grupo de Telegram.
# /api/order-notify usa además VITE_API_URL/VITE_API_KEY (o TRAELO_API_URL/TRAELO_API_KEY) para leer
# el pedido real del backend antes de avisar.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Clave pública VAPID (Web Push) — no es secreta. Debe ser la misma pareja que VAPID_PUBLIC_KEY/
# VAPID_PRIVATE_KEY del backend (ver ese .env.example). Sin ella, la web no ofrece activar
# notificaciones de pedido.
VITE_VAPID_PUBLIC_KEY=
