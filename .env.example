# Backend de Tráelo (el mismo que usa la app móvil). Sin /api/v1: lo agrega src/config/env.ts.
# Pruebas: https://backend-fi7x.onrender.com
VITE_API_URL=https://backend-fi7x.onrender.com

# X-Api-Key del backend (MOBILE_APP_API_KEY en el servidor). Ponerla en Vercel y en .env.local.
VITE_API_KEY=

# Solo en Vercel (funciones /api, nunca en el navegador): aviso de pedidos al grupo de Telegram.
# /api/order-notify usa además VITE_API_URL/VITE_API_KEY (o TRAELO_API_URL/TRAELO_API_KEY) para leer
# el pedido real del backend antes de avisar.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
